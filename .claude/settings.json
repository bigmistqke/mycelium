{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "permissions": {
    "deny": [
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(ts-node:*)",
      "Bash(tsx:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node src/run.ts followup list 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node src/run.ts 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
