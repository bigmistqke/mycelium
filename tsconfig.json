{
  // Node 24 executes src/*.ts and src/*.js directly: no build step, no emit.
  "compilerOptions": {
    // Node 24 strips types, it does not compile them; a runtime construct (enum, namespace, parameter property) would erase into nothing.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // Imports carry their real extension ("./utils.js"), the way Node wants them.
    "allowImportingTsExtensions": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,

    "target": "esnext",
    // happy-dom supplies Element/Document/Node at runtime; dom is what names them at author time.
    "lib": ["esnext", "dom"],
    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // A mycelium/* script may import a type="module" sibling by #id; without this a .js import is implicitly any.
    "allowJs": true,
    // Global, not per-file @ts-check: three of six *.element.js files once carried the pragma and three didn't, leaving half unchecked with nothing saying so.
    "checkJs": true
  },
  // Only src/, editor/ and the corpus's own .html/.js files — everything else lives inside <script type="mycelium/*"> blocks the compiler can't read; that's the language server's job.
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "editor/**/*.ts",
    ".mycelium/**/*.html",
    ".mycelium/templates/*.js"
  ]
}
