.mycelium/chain.html

# Everywhere a family's own page.<verb> lands when mycelium page generate
# writes it — derived from the corpus on demand, so nothing under here is
# a source file either.
.mycelium/page/

# Written by `mycelium canon test` beside a test document, one per failing case.
# A picture of a run, not of the repository, and the next run replaces it.
.mycelium/**/*.failure.png

