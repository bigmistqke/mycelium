{
  "nodes": [
    {
      "id": "func-abs",
      "layer": "function",
      "title": "abs",
      "inputs": ["x: i32"],
      "outputs": ["i32"],
      "description": "Returns the absolute value of a number",
      "tests": [
        { "in": { "x": 5 }, "out": 5 },
        { "in": { "x": -5 }, "out": 5 },
        { "in": { "x": 0 }, "out": 0 }
      ]
    },

    {
      "id": "flow-abs",
      "layer": "dataflow",
      "nodes": [
        { "id": "x", "kind": "input" },
        { "id": "zero", "kind": "const", "value": 0 },
        { "id": "cmp", "kind": "op", "op": "i32.lt_s" },
        { "id": "neg", "kind": "op", "op": "i32.sub" },
        { "id": "sel", "kind": "select" },
        { "id": "result", "kind": "output" }
      ],
      "edges": [
        { "from": "x", "to": "cmp", "port": 0 },
        { "from": "zero", "to": "cmp", "port": 1 },
        { "from": "zero", "to": "neg", "port": 0 },
        { "from": "x", "to": "neg", "port": 1 },
        { "from": "cmp", "to": "sel", "port": "condition" },
        { "from": "neg", "to": "sel", "port": "true" },
        { "from": "x", "to": "sel", "port": "false" },
        { "from": "sel", "to": "result" }
      ]
    },

    {
      "id": "ast-abs",
      "layer": "ast",
      "root": {
        "kind": "func",
        "name": "abs",
        "params": [{ "name": "x", "type": "i32" }],
        "result": "i32",
        "body": {
          "kind": "select",
          "condition": {
            "kind": "op",
            "op": "i32.lt_s",
            "args": [
              { "kind": "local.get", "name": "x" },
              { "kind": "const", "type": "i32", "value": 0 }
            ]
          },
          "true": {
            "kind": "op",
            "op": "i32.sub",
            "args": [
              { "kind": "const", "type": "i32", "value": 0 },
              { "kind": "local.get", "name": "x" }
            ]
          },
          "false": { "kind": "local.get", "name": "x" }
        }
      }
    }
  ],

  "edges": [
    { "from": "func-abs", "to": "flow-abs", "type": "implemented_by" },
    { "from": "flow-abs", "to": "ast-abs", "type": "compiles_to" }
  ]
}
