{
  "nodes": [
    {
      "id": "vision-calc",
      "layer": "vision",
      "title": "Interactive calculator"
    },

    {
      "id": "arch-calc",
      "layer": "architecture",
      "title": "Functional state-threading calculator"
    },

    {
      "id": "comp-calc",
      "layer": "component",
      "title": "Calculator module"
    },

    {
      "id": "func-on-key",
      "layer": "function",
      "title": "on_key",
      "inputs": ["acc: i32", "buf: i32", "op: i32", "key: i32"],
      "outputs": ["i32", "i32", "i32"],
      "description": "Pure function: takes current state + keycode, returns new state. Digits accumulate in buffer, +/- set operation, enter executes.",
      "tests": [
        {
          "in": { "acc": 0, "buf": 0, "op": 0, "key": 53 },
          "out": [0, 5, 0],
          "note": "Press '5' -> buffer becomes 5"
        },
        {
          "in": { "acc": 0, "buf": 5, "op": 0, "key": 187 },
          "out": [5, 0, 1],
          "note": "Press '+' -> acc=5, buffer cleared, op=add"
        },
        {
          "in": { "acc": 5, "buf": 0, "op": 1, "key": 51 },
          "out": [5, 3, 1],
          "note": "Press '3' -> buffer becomes 3"
        },
        {
          "in": { "acc": 5, "buf": 3, "op": 1, "key": 13 },
          "out": [8, 0, 0],
          "note": "Press enter -> acc = 5+3 = 8, buffer cleared"
        },
        {
          "in": { "acc": 10, "buf": 4, "op": 2, "key": 13 },
          "out": [6, 0, 0],
          "note": "Press enter with subtract -> acc = 10-4 = 6"
        }
      ]
    },

