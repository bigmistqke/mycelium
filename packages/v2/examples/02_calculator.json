{
  "nodes": [
    {
      "id": "vision-calc",
      "layer": "vision",
      "title": "Interactive calculator"
    },

    {
      "id": "arch-calc",
      "layer": "architecture",
      "title": "Event-driven WASM calculator"
    },

    {
      "id": "comp-calc",
      "layer": "component",
      "title": "Calculator module"
    },

    {
      "id": "func-on-key",
      "layer": "function",
      "title": "on_key",
      "inputs": ["keycode: i32"],
      "outputs": ["void"],
      "description": "Handles keypress: digits accumulate input, +/- set operation, = executes, c clears",
      "imports": ["display: (i32) -> void"],
      "exports": ["on_key"],
      "tests": [
        {
          "sequence": [
            { "key": 53 },
            { "key": 187 },
            { "key": 51 },
            { "key": 13 }
          ],
          "displays": [5, 5, 3, 8],
          "note": "5 + 3 = 8 (keycodes: 5, +, 3, enter)"
        }
      ]
    },

    {
      "id": "flow-on-key",
      "layer": "dataflow",
      "state": [
        { "id": "accumulator", "type": "i32", "initial": 0 },
        { "id": "input_buffer", "type": "i32", "initial": 0 },
        { "id": "current_op", "type": "i32", "initial": 0 }
      ],
      "nodes": [
        { "id": "keycode", "kind": "input" },
        { "id": "is_digit", "kind": "op", "op": "is_digit" },
        { "id": "is_plus", "kind": "op", "op": "i32.eq", "args": ["keycode", 187] },
        { "id": "is_minus", "kind": "op", "op": "i32.eq", "args": ["keycode", 189] },
        { "id": "is_enter", "kind": "op", "op": "i32.eq", "args": ["keycode", 13] },
        { "id": "is_clear", "kind": "op", "op": "i32.eq", "args": ["keycode", 67] },
        { "id": "dispatch", "kind": "switch" },
        { "id": "handle_digit", "kind": "block" },
        { "id": "handle_op", "kind": "block" },
        { "id": "handle_execute", "kind": "block" },
        { "id": "handle_clear", "kind": "block" },
        { "id": "display", "kind": "effect", "op": "display" }
      ],
      "edges": [
        { "from": "keycode", "to": "is_digit" },
        { "from": "keycode", "to": "is_plus" },
        { "from": "keycode", "to": "is_minus" },
        { "from": "keycode", "to": "is_enter" },
        { "from": "keycode", "to": "is_clear" },
        { "from": "is_digit", "to": "dispatch", "port": "digit" },
        { "from": "is_plus", "to": "dispatch", "port": "plus" },
        { "from": "is_minus", "to": "dispatch", "port": "minus" },
        { "from": "is_enter", "to": "dispatch", "port": "enter" },
        { "from": "is_clear", "to": "dispatch", "port": "clear" },
        { "from": "dispatch", "to": "handle_digit", "case": "digit" },
        { "from": "dispatch", "to": "handle_op", "case": "plus" },
        { "from": "dispatch", "to": "handle_op", "case": "minus" },
        { "from": "dispatch", "to": "handle_execute", "case": "enter" },
        { "from": "dispatch", "to": "handle_clear", "case": "clear" },
        { "from": "handle_digit", "to": "display" },
        { "from": "handle_op", "to": "display" },
        { "from": "handle_execute", "to": "display" },
        { "from": "handle_clear", "to": "display" }
      ]
    },

    {
      "id": "ast-on-key",
      "layer": "ast",
      "imports": [
        { "module": "env", "name": "display", "kind": "func", "params": ["i32"], "result": null }
      ],
      "globals": [
        { "name": "accumulator", "type": "i32", "mutable": true, "initial": 0 },
        { "name": "input_buffer", "type": "i32", "mutable": true, "initial": 0 },
        { "name": "current_op", "type": "i32", "mutable": true, "initial": 0 }
      ],
      "root": {
        "kind": "func",
        "name": "on_key",
        "export": true,
        "params": [{ "name": "keycode", "type": "i32" }],
        "result": null,
        "body": {
          "kind": "block",
          "children": [
            {
              "kind": "if",
              "condition": { "kind": "call", "fn": "is_digit", "args": [{ "kind": "local.get", "name": "keycode" }] },
              "then": {
                "kind": "block",
                "children": [
                  { "kind": "global.set", "name": "input_buffer",
                    "value": { "kind": "op", "op": "i32.add",
                      "args": [
                        { "kind": "op", "op": "i32.mul", "args": [{ "kind": "global.get", "name": "input_buffer" }, { "kind": "const", "value": 10 }] },
                        { "kind": "call", "fn": "digit_value", "args": [{ "kind": "local.get", "name": "keycode" }] }
                      ]
                    }
                  },
                  { "kind": "call", "fn": "display", "args": [{ "kind": "global.get", "name": "input_buffer" }] }
                ]
              }
            },
            {
              "kind": "if",
              "condition": { "kind": "op", "op": "i32.eq", "args": [{ "kind": "local.get", "name": "keycode" }, { "kind": "const", "value": 187 }] },
              "then": {
                "kind": "block",
                "children": [
                  { "kind": "global.set", "name": "accumulator", "value": { "kind": "global.get", "name": "input_buffer" } },
                  { "kind": "global.set", "name": "input_buffer", "value": { "kind": "const", "value": 0 } },
                  { "kind": "global.set", "name": "current_op", "value": { "kind": "const", "value": 1 } }
                ]
              }
            },
            {
              "kind": "if",
              "condition": { "kind": "op", "op": "i32.eq", "args": [{ "kind": "local.get", "name": "keycode" }, { "kind": "const", "value": 189 }] },
              "then": {
                "kind": "block",
                "children": [
                  { "kind": "global.set", "name": "accumulator", "value": { "kind": "global.get", "name": "input_buffer" } },
                  { "kind": "global.set", "name": "input_buffer", "value": { "kind": "const", "value": 0 } },
                  { "kind": "global.set", "name": "current_op", "value": { "kind": "const", "value": 2 } }
                ]
              }
            },
            {
              "kind": "if",
              "condition": { "kind": "op", "op": "i32.eq", "args": [{ "kind": "local.get", "name": "keycode" }, { "kind": "const", "value": 13 }] },
              "then": {
                "kind": "block",
                "children": [
                  {
                    "kind": "if",
                    "condition": { "kind": "op", "op": "i32.eq", "args": [{ "kind": "global.get", "name": "current_op" }, { "kind": "const", "value": 1 }] },
                    "then": { "kind": "global.set", "name": "accumulator",
                      "value": { "kind": "op", "op": "i32.add", "args": [{ "kind": "global.get", "name": "accumulator" }, { "kind": "global.get", "name": "input_buffer" }] }
                    }
                  },
                  {
                    "kind": "if",
                    "condition": { "kind": "op", "op": "i32.eq", "args": [{ "kind": "global.get", "name": "current_op" }, { "kind": "const", "value": 2 }] },
                    "then": { "kind": "global.set", "name": "accumulator",
                      "value": { "kind": "op", "op": "i32.sub", "args": [{ "kind": "global.get", "name": "accumulator" }, { "kind": "global.get", "name": "input_buffer" }] }
                    }
                  },
                  { "kind": "global.set", "name": "input_buffer", "value": { "kind": "const", "value": 0 } },
                  { "kind": "call", "fn": "display", "args": [{ "kind": "global.get", "name": "accumulator" }] }
                ]
              }
            }
          ]
        }
      }
    }
  ],

  "edges": [
    { "from": "vision-calc", "to": "arch-calc", "type": "motivates" },
    { "from": "arch-calc", "to": "comp-calc", "type": "contains" },
    { "from": "comp-calc", "to": "func-on-key", "type": "exposes" },
    { "from": "func-on-key", "to": "flow-on-key", "type": "implemented_by" },
    { "from": "flow-on-key", "to": "ast-on-key", "type": "compiles_to" }
  ]
}
