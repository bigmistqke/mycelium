#!/usr/bin/env bash
#
# commit-msg hook — the code→intent edge.
#
# Requires every commit to carry a `Decision:` trailer naming a decision-graph node,
# and VERIFIES the citation rather than trusting it:
#
#   1. the trailer is present                       else reject
#   2. the UUID resolves to exactly one node        else reject
#   3. if that node declares files, they overlap
#      the files this commit actually touches       else reject
#
# Step 3 is the point. An agent asked to cite something will cite something — the
# check is what makes a confabulated citation expensive to construct. Never ask a
# model to label; make it back a claim that something else can check.
#
# Cite the UUID (change_id), never the integer id: commit messages are immutable, and
# the integer is a display alias that will not survive a migration to another store.

set -uo pipefail

MSG_FILE="$1"
REPO_ROOT="$(git rev-parse --show-toplevel)"
DB="$REPO_ROOT/.deciduous/deciduous.db"

# Don't police merges, fixups, squashes, or reverts — they inherit their subject.
head -1 "$MSG_FILE" | grep -qE '^(Merge|Revert|fixup!|squash!)' && exit 0
[ -f "$REPO_ROOT/.git/MERGE_HEAD" ] && exit 0

if [ ! -f "$DB" ]; then
  echo "trace: no decision graph at .deciduous/deciduous.db — skipping" >&2
  exit 0
fi
if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "trace: sqlite3 not found — skipping" >&2
  exit 0
fi

reject() {
  echo "" >&2
  echo "  ✗ COMMIT REJECTED — $1" >&2
  echo "" >&2
  shift
  for line in "$@"; do echo "    $line" >&2; done
  echo "" >&2
  echo "    Every commit must name the decision it serves, so that a line of code" >&2
  echo "    can be traced back to the reasoning behind it:" >&2
  echo "" >&2
  echo "        git blame → commit → Decision: <uuid> → the node → the why" >&2
  echo "" >&2
  echo "    Add a trailer (cite the change_id UUID, not the integer id):" >&2
  echo "" >&2
  echo "        Decision: $(sqlite3 "$DB" "SELECT change_id FROM decision_nodes ORDER BY id DESC LIMIT 1;" 2>/dev/null)" >&2
  echo "" >&2
  echo "    Find one with:  deciduous nodes | tail" >&2
  echo "                    sqlite3 .deciduous/deciduous.db \\" >&2
  echo "                      \"SELECT change_id, title FROM decision_nodes ORDER BY id DESC LIMIT 5;\"" >&2
  echo "" >&2
  exit 1
}

# --- 1. trailer present? ------------------------------------------------------
mapfile -t CITED < <(git interpret-trailers --parse <"$MSG_FILE" \
                     | grep -iE '^(Decision|Implements):' \
                     | sed -E 's/^[^:]+:[[:space:]]*//')

if [ ${#CITED[@]} -eq 0 ]; then
  reject "no Decision: trailer" \
         "This commit does not say which decision it serves."
fi

# What this commit actually touches.
mapfile -t CHANGED < <(git diff --cached --name-only)

VERIFIED=0
UNVERIFIABLE=()

for RAW in "${CITED[@]}"; do
  UUID="$(echo "$RAW" | tr -d '[:space:]')"

  # --- 2. resolves to exactly one node? ---------------------------------------
  MATCHES=$(sqlite3 "$DB" \
    "SELECT COUNT(*) FROM decision_nodes WHERE change_id LIKE '${UUID}%';" 2>/dev/null)

  if [ "${MATCHES:-0}" -eq 0 ]; then
    reject "Decision: $UUID does not resolve to any node" \
           "The graph has no node with that change_id." \
           "A citation that names nothing is worse than no citation — it looks like provenance."
  fi
  if [ "${MATCHES:-0}" -gt 1 ]; then
    reject "Decision: $UUID is ambiguous ($MATCHES nodes match)" \
           "Use more of the UUID."
  fi

  TITLE=$(sqlite3 "$DB" \
    "SELECT substr(title,1,68) FROM decision_nodes WHERE change_id LIKE '${UUID}%';")
  FILES=$(sqlite3 "$DB" \
    "SELECT COALESCE(json_extract(metadata_json,'\$.files'),'') FROM decision_nodes WHERE change_id LIKE '${UUID}%';")

  # --- 3. do the node's declared files overlap what changed? ------------------
  if [ -z "$FILES" ] || [ "$FILES" = "null" ]; then
    UNVERIFIABLE+=("$UUID — $TITLE")
    continue
  fi

  DECLARED=$(echo "$FILES" | sed -E 's/[][""]//g' | tr ',' '\n' | sed '/^$/d')
  HIT=0
  while IFS= read -r d; do
    d="$(echo "$d" | sed -E 's#^[[:space:]]+|[[:space:]]+$##g; s#/+$##')"  # trim, drop trailing /
    [ -z "$d" ] && continue
    for c in "${CHANGED[@]}"; do
      # a declared path matches if it equals the changed file, or is a directory prefix of it
      case "$c" in
        "$d"|"$d"/*) HIT=1; break 2 ;;
      esac
    done
  done <<<"$DECLARED"

  if [ "$HIT" -eq 0 ]; then
    reject "Decision: $UUID does not touch the files this commit changes" \
           "node declares:  $(echo "$DECLARED" | tr '\n' ' ')" \
           "commit changes: ${CHANGED[*]}" \
           "" \
           "The citation is unverified. Either cite the node that actually governs" \
           "this change, or update the node's files with:  deciduous add ... -f ..."
  fi
  VERIFIED=$((VERIFIED + 1))
done

if [ "$VERIFIED" -eq 0 ] && [ ${#UNVERIFIABLE[@]} -gt 0 ]; then
  echo "" >&2
  echo "  ⚠ trace: citation accepted but UNVERIFIED — no cited node declares any files." >&2
  for u in "${UNVERIFIABLE[@]}"; do echo "      $u" >&2; done
  echo "    Nothing checked that this commit has anything to do with that decision." >&2
  echo "    Give the node files (-f) to make the citation checkable." >&2
  echo "" >&2
fi

exit 0
