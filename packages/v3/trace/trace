#!/usr/bin/env bash
#
# trace — walk between code and the reasoning behind it.
#
#   trace why  <file>:<line>   a line of code  → the decisions that produced it
#   trace code <uuid|id>       a decision      → every line of code that exists because of it
#   trace gaps                 which commits have no citation (the honest coverage number)
#
# Both directions run on git alone. The decision graph is only consulted to turn a
# UUID into a title — the EDGE itself lives in the commit message, so it survives the
# tool, travels with `git push`, and needs no index.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
DB="$REPO_ROOT/.deciduous/deciduous.db"

node_line() { # uuid -> "#id  type  title"
  sqlite3 "$DB" "SELECT '#'||id||'  '||node_type||'  '||title
                 FROM decision_nodes WHERE change_id LIKE '${1}%' LIMIT 1;" 2>/dev/null
}

cmd_why() {
  local target="${1:-}"
  [ -z "$target" ] && { echo "usage: trace why <file>:<line>" >&2; exit 1; }
  local file="${target%%:*}" line="${target##*:}"
  [ "$file" = "$line" ] && { echo "usage: trace why <file>:<line>" >&2; exit 1; }

  local sha
  sha=$(git blame -L "$line,$line" --porcelain -- "$file" 2>/dev/null | head -1 | cut -d' ' -f1)
  [ -z "$sha" ] && { echo "no blame for $file:$line" >&2; exit 1; }

  echo ""
  echo "  $file:$line"
  echo "    ↓ git blame"
  echo "  ${sha:0:9}  $(git log -1 --format=%s "$sha")"

  local cited
  cited=$(git log -1 --format='%(trailers:key=Decision,valueonly)%(trailers:key=Implements,valueonly)' "$sha" \
          | tr -d ' ' | sed '/^$/d')

  if [ -z "$cited" ]; then
    echo "    ↓"
    echo "  ✗ DEAD END — this commit cites no decision."
    echo "    The reasoning behind this line was never recorded, and cannot be recovered."
    echo ""
    return 1
  fi

  echo "    ↓ Decision: trailer"
  while IFS= read -r uuid; do
    [ -z "$uuid" ] && continue
    local n; n=$(node_line "$uuid")
    if [ -z "$n" ]; then
      echo "  ✗ ${uuid:0:8}  — cited, but no such node in the graph"
    else
      echo "  $n"
    fi
  done <<<"$cited"
  echo ""
}

cmd_code() {
  local ref="${1:-}"
  [ -z "$ref" ] && { echo "usage: trace code <uuid|id>" >&2; exit 1; }

  # accept an integer id and resolve it to the uuid
  local uuid="$ref"
  if [[ "$ref" =~ ^[0-9]+$ ]]; then
    uuid=$(sqlite3 "$DB" "SELECT change_id FROM decision_nodes WHERE id = $ref;" 2>/dev/null)
    [ -z "$uuid" ] && { echo "no node #$ref" >&2; exit 1; }
  fi

  echo ""
  echo "  $(node_line "$uuid")"
  echo "    ↓ every commit that cites it"
  local found=0
  while IFS= read -r sha; do
    [ -z "$sha" ] && continue
    found=1
    echo "  ${sha:0:9}  $(git log -1 --format=%s "$sha")"
    git show --stat --format='' "$sha" | sed 's/^/       /' | head -6
  done < <(git log --format='%H' --grep="$uuid")
  [ "$found" -eq 0 ] && echo "  (no code exists because of this decision — yet)"
  echo ""
}

cmd_gaps() {
  local total=0 cited=0
  while IFS= read -r sha; do
    total=$((total+1))
    if git log -1 --format='%(trailers:key=Decision)' "$sha" | grep -q .; then
      cited=$((cited+1))
    fi
  done < <(git log --format='%H')
  echo ""
  echo "  commits:            $total"
  echo "  citing a decision:  $cited"
  echo "  traceable:          $(( total ? 100*cited/total : 0 ))%"
  echo ""
  echo "  A line of code whose commit cites nothing is a line whose reasoning is gone."
  echo ""
}

case "${1:-}" in
  why)  shift; cmd_why  "${1:-}" ;;
  code) shift; cmd_code "${1:-}" ;;
  gaps) shift; cmd_gaps ;;
  *)
    cat <<'EOF'

  trace — walk between code and the reasoning behind it

    trace why  <file>:<line>    a line of code → the decisions that produced it
    trace code <uuid|id>        a decision → every line of code that exists because of it
    trace gaps                  what fraction of commits are traceable at all

EOF
    ;;
esac
