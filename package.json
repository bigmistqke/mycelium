{
  "name": "mycelium",
  "version": "0.0.0",
  "description": "Intent-driven programming substrate",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bigmistqke/mycelium.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mycelium": "./bin/mycelium.js"
  },
  "exports": {
    "./api": "./src/api.ts",
    "./utils": "./src/utils.js",
    "./retext": "./src/retext.js",
    "./shared": "./.mycelium/templates/shared.js",
    "./extract-graph": "./.mycelium/templates/extract-graph.js",
    "./language-prose": "./.mycelium/templates/language-prose.js",
    "./code-comments": "./.mycelium/templates/code-comments.js",
    "./canon-citations": "./.mycelium/templates/canon-citations.js"
  },
  "files": [
    "bin",
    "src",
    ".mycelium/templates",
    ".mycelium/commands",
    ".mycelium/language",
    ".mycelium/lib",
    ".mycelium/theme.css",
    ".mycelium/tokens.css"
  ],
  "scripts": {
    "mycelium": "node bin/mycelium.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check-scripts": "node editor/check.ts"
  },
  "dependencies": {
    "happy-dom": "^20.11.0",
    "ignore": "^7.0.6",
    "marked": "^18.0.7",
    "parse5": "^8.0.1",
    "retext": "^9.0.0",
    "retext-passive": "^5.0.0",
    "retext-stringify": "^4.0.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@volar/kit": "2.4.28",
    "@volar/language-core": "2.4.28",
    "@volar/language-server": "2.4.28",
    "@volar/typescript": "2.4.28",
    "mycelium": "link:.",
    "volar-service-typescript": "^0.0.71",
    "vscode-uri": "^3.1.0"
  }
}
